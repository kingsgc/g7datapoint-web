###############################################################################
# G7DataPoint — environment template
#
# Copy to .env on the server and fill in real values:
#     cp .env.example .env && php artisan key:generate
#
# Never commit a filled-in .env. There is no git repository in this project,
# so .gitignore gives you no protection when copying files up by FTP or drag
# and drop — remove .env from the upload yourself.
###############################################################################

APP_NAME="G7DataPoint"

# Must be "production" on the live host. Note that APP_ENV=local turns on a
# bypass in App\Http\Middleware\FrontendSecure that disables the API origin
# check entirely, so never leave it as "local" in production.
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# The real public URL. This is the single most important value on this page:
# APP_URL, FRONT_END_URL and ALLOWED_ORIGINS together form the whitelist of
# browser origins allowed to call /api/*. If these are wrong, every API call
# from the browser returns HTTP 403 with "Unauthorized. Access denied."
APP_URL=https://g7datapoint.com

# Public SPA / marketing host, used for the API origin whitelist and for the
# network logo image URLs in transaction notifications (API/Trans.php).
FRONT_END_URL=https://g7datapoint.com

# Optional. Extra browser origins beyond APP_URL and FRONT_END_URL, comma
# separated, no spaces needed. Only needed if the SPA is served from an
# additional host (for example a separate app. subdomain or an admin domain).
#   ALLOWED_ORIGINS=https://app.g7datapoint.com,https://www.g7datapoint.com
ALLOWED_ORIGINS=

# Optional. Rotates the shared key that non-browser clients (the mobile app
# and integrations) send as the Authorization header. When left empty the app
# falls back to the historical constant baked into
# App\Http\Middleware\FrontendSecure::myKeySecure — that fallback keeps old
# clients working, but it also means the key is public in the source. Set a
# long random value here to rotate it, then update your clients to match.
FRONTEND_SECURE_KEY=

APP_EMAIL='suuport@g7datapoint.com'

# Initial admin credentials, consumed by the
# 2026_10_03_1655_update_admin_user migration on a fresh install.
# The password is hashed; the pin is stored in plain text because the app
# compares it that way. When either is unset the migration leaves that field
# alone rather than blanking it, so leave both unset anywhere that already
# has an admin user. Change these on a live host -- do not reuse admin@123.
# ADMIN_INITIAL_PASSWORD=
# ADMIN_INITIAL_PIN=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
# Do not ship an empty DB_PASSWORD on a live host.
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS='suuport@g7datapoint.com'
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Storage / third-party
###############################################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FIREBASE_CREDENTIALS=